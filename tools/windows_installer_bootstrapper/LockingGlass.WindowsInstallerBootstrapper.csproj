<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>LockingGlass.WindowsInstallerBootstrapper</AssemblyName>
    <RootNamespace>LockingGlass.WindowsInstallerBootstrapper</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <!-- The same source builds installer and uninstaller executables. -->
    <BootstrapperMode Condition="'$(BootstrapperMode)' == ''">install</BootstrapperMode>
    <BootstrapperFileDescription Condition="'$(BootstrapperMode)' == 'install'">Locking Glass Installer</BootstrapperFileDescription>
    <BootstrapperFileDescription Condition="'$(BootstrapperMode)' == 'run'">Locking Glass</BootstrapperFileDescription>
    <BootstrapperFileDescription Condition="'$(BootstrapperMode)' == 'uninstall'">Locking Glass Uninstaller</BootstrapperFileDescription>
    <BootstrapperFileDescription Condition="'$(BootstrapperFileDescription)' == ''">Locking Glass</BootstrapperFileDescription>
    <AssemblyTitle>$(BootstrapperFileDescription)</AssemblyTitle>
    <Description>$(BootstrapperFileDescription)</Description>
    <FileDescription>$(BootstrapperFileDescription)</FileDescription>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LockingGlassBootstrapperMode</_Parameter1>
      <_Parameter2>$(BootstrapperMode)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The embedded flat payload is validated against LOCKING_GLASS_PAYLOAD_MANIFEST.txt. -->
  <ItemGroup Condition="Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
