#include <winver.h>
#include "windows_resource.h"

// Release builds inject VERSION-derived macros. The zero fallbacks only keep
// ad hoc resource compilation possible outside the release pipeline.
#ifndef LOCKING_GLASS_VERSION_MAJOR
#define LOCKING_GLASS_VERSION_MAJOR 0
#endif

#ifndef LOCKING_GLASS_VERSION_MINOR
#define LOCKING_GLASS_VERSION_MINOR 0
#endif

#ifndef LOCKING_GLASS_VERSION_PATCH
#define LOCKING_GLASS_VERSION_PATCH 0
#endif

#define LOCKING_GLASS_STRINGIFY_INNER(value) #value
#define LOCKING_GLASS_STRINGIFY(value) LOCKING_GLASS_STRINGIFY_INNER(value)

#ifndef LOCKING_GLASS_VERSION_STR
#define LOCKING_GLASS_VERSION_STR \
  LOCKING_GLASS_STRINGIFY(LOCKING_GLASS_VERSION_MAJOR) "." \
  LOCKING_GLASS_STRINGIFY(LOCKING_GLASS_VERSION_MINOR) "." \
  LOCKING_GLASS_STRINGIFY(LOCKING_GLASS_VERSION_PATCH)
#endif

#ifndef LOCKING_GLASS_FILE_VERSION
#define LOCKING_GLASS_FILE_VERSION \
  LOCKING_GLASS_VERSION_MAJOR,LOCKING_GLASS_VERSION_MINOR, \
  LOCKING_GLASS_VERSION_PATCH,0
#endif

LOCKING_GLASS_APP_ICON ICON "assets/locking-glass.ico"
LOCKING_GLASS_TRAY_LOCKED_16_PNG RCDATA "assets/icons/tray/locked/16.png"
LOCKING_GLASS_TRAY_LOCKED_32_PNG RCDATA "assets/icons/tray/locked/32.png"
LOCKING_GLASS_TRAY_UNLOCKED_16_PNG RCDATA "assets/icons/tray/unlocked/16.png"
LOCKING_GLASS_TRAY_UNLOCKED_32_PNG RCDATA "assets/icons/tray/unlocked/32.png"
LOCKING_GLASS_OVERLAY_LOCKED_128_PNG RCDATA "assets/icons/overlay/locked/128.png"
LOCKING_GLASS_OVERLAY_UNLOCKED_128_PNG RCDATA "assets/icons/overlay/unlocked/128.png"

1 VERSIONINFO
FILEVERSION LOCKING_GLASS_FILE_VERSION
PRODUCTVERSION LOCKING_GLASS_FILE_VERSION
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Locking Glass Contributors\0"
      VALUE "FileDescription", "Locking Glass\0"
      VALUE "FileVersion", LOCKING_GLASS_VERSION_STR
      VALUE "InternalName", "locking_glass\0"
      VALUE "OriginalFilename", "Locking Glass.exe\0"
      VALUE "ProductName", "Locking Glass\0"
      VALUE "ProductVersion", LOCKING_GLASS_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
